# FaamOffice web — environment variables. Copy to .env and adjust.
# Values marked [build] are inlined at `npm run build` time (static pages,
# client bundles): rebuild after changing them.

# ---------------------------------------------------------------- site
# [build] Public base URL (no trailing slash). Used for canonical URLs, hreflang,
# sitemap, Open Graph, email links and the device-flow verification_uri.
SITE_URL=http://localhost:3000

# [build] GitHub repository whose Releases provide the desktop installers.
NEXT_PUBLIC_GITHUB_REPO=dinhthaicx/faamoffice

# Optional GitHub token (read-only, public repos) to avoid API rate limits when
# the download page refreshes the latest release (hourly).
# GITHUB_TOKEN=

# ---------------------------------------------------------------- database
# SQLite file (relative to the web/ folder). For PostgreSQL see README.md.
DATABASE_URL=file:./data/faamoffice.db

# ---------------------------------------------------------------- accounts
# Credits granted to every new account (recorded in the credit ledger). Granted
# even while Faam credits are turned off in admin Settings (then never shown).
SIGNUP_BONUS_CREDITS=100

# Comma-separated emails that become ADMIN when they register or sign in.
ADMIN_EMAILS=

# Session cookies are Secure (and named __Host-fo_session) when SITE_URL is
# https. Override only for special setups (true/false).
# COOKIE_SECURE=

# Optional: `npm run db:seed` creates/updates this admin account.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-please
# Optional: `npm run db:seed` also sets the Faam credits mode (true/false) and the
# daily Faam AI request limit used while credits are off (0 = unlimited), like
# admin Settings. Unset = leave the stored settings alone.
# SEED_CREDITS_ENABLED=false
# SEED_AI_DAILY_LIMIT=300

# ---------------------------------------------------------------- email
# When SMTP_HOST is empty, emails (verification / password reset links) are
# printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); STARTTLS is used automatically otherwise.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FaamOffice <no-reply@example.com>"

# ---------------------------------------------------------------- Faam AI Cloud
# OpenAI-compatible upstream used by /api/v1/ai/chat/completions.
# Leave empty to disable Faam AI Cloud (the endpoints answer 503).
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1   (no key needed)
FAAM_AI_UPSTREAM_BASE_URL=
FAAM_AI_UPSTREAM_API_KEY=

# Local Ollama: document-editing prompts include the document tool schemas.
# A 4096-token context truncates those prompts even when ordinary chat works.
# Map FAAM_AI_MODELS to installed Ollama models, then run:
# npm run ai:configure-ollama -- --apply
# This creates dedicated 65536-token aliases; it preserves the original models.
# For Qwen 3.5, faam-fast defaults to reasoningEffort "none" for quick drafting.
# Restart the website process after applying (no desktop rebuild is needed).
# Context size cannot be set through an OpenAI-compatible /v1 request.

# Public model catalog and prices (credits per 1,000 tokens; fractions allowed).
#   id               public model id the desktop app sends
#   upstream         model id sent to the upstream server
#   inputPer1K       credits per 1K prompt tokens
#   outputPer1K      credits per 1K completion tokens
#   maxOutputTokens  cap applied to max_tokens / max_completion_tokens (optional)
# When unset, the same defaults as below are used.
FAAM_AI_MODELS='[{"id":"faam-fast","upstream":"gpt-5-mini","inputPer1K":1,"outputPer1K":4,"maxOutputTokens":32768},{"id":"faam-pro","upstream":"gpt-5","inputPer1K":5,"outputPer1K":20,"maxOutputTokens":32768}]'

# Upstream request timeout in milliseconds (default 10 minutes).
# FAAM_AI_REQUEST_TIMEOUT_MS=600000
