// FaamOffice web backend data model.
//
// SQLite is the default datasource for local development. To switch to
// PostgreSQL, change `provider` below to "postgresql", swap the driver adapter
// in src/lib/db.ts (see README.md → "Switching to PostgreSQL") and create a
// fresh migration history with `npx prisma migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum EmailTokenKind {
  verify
  reset
}

enum DeviceCodeStatus {
  pending
  approved
  denied
  consumed
}

enum CreditReason {
  signup_bonus
  admin_adjust
  ai_usage
}

enum AnnouncementStatus {
  draft
  published
}

enum AnnouncementKind {
  /// Image + title + plain-text body + link button, rendered by the desktop app.
  rich
  /// Admin-authored HTML served from /announcement-frame/{id} (sandboxed, no scripts).
  html
}

enum AnnouncementLevel {
  info
  warning
  critical
}

enum AnnouncementDisplayMode {
  /// Shown one time per device.
  once
  /// Shown on every app start while active.
  every_launch
  /// Shown on every app start until the user ticks "don't show again".
  until_dismissed
}

model User {
  id              String    @id @default(cuid())
  /// Always stored lowercase and trimmed.
  email           String    @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  role            Role      @default(USER)
  disabledAt      DateTime?
  /// Current Faam AI Cloud credit balance (may go slightly negative after the last request).
  credits         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions             Session[]
  emailTokens          EmailToken[]
  deviceCodes          DeviceCode[]
  apiTokens            ApiToken[]
  creditTransactions   CreditTransaction[] @relation("CreditOwner")
  actedTransactions    CreditTransaction[] @relation("CreditActor")
  usageRecords         UsageRecord[]
  createdAnnouncements Announcement[]      @relation("AnnouncementCreator")
  updatedAnnouncements Announcement[]      @relation("AnnouncementUpdater")

  @@index([createdAt])
  @@index([name])
}

/// Web browser sessions (httpOnly cookie). Only the SHA-256 hash of the cookie value is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use email verification and password reset tokens (hashed).
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

/// RFC 8628 device authorization requests from the desktop app.
model DeviceCode {
  id             String           @id @default(cuid())
  deviceCodeHash String           @unique
  /// Normalized form "ABCD-EFGH".
  userCode       String           @unique
  clientId       String
  deviceName     String
  status         DeviceCodeStatus @default(pending)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Minimum polling interval in seconds (raised by 5 on every slow_down).
  interval       Int              @default(5)
  expiresAt      DateTime
  lastPolledAt   DateTime?
  approvedAt     DateTime?
  /// The API token issued when the device code was consumed.
  tokenId        String?
  createdAt      DateTime         @default(now())

  @@index([expiresAt])
  @@index([userId])
}

/// Bearer tokens for signed-in desktop apps ("fo_..."). Only the SHA-256 hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  usageRecords UsageRecord[]

  @@index([userId, revokedAt])
}

/// Credit ledger. The sum of `delta` for a user equals `User.credits`.
model CreditTransaction {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("CreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  delta         Int
  balanceAfter  Int
  reason        CreditReason
  note          String?
  actorId       String?
  actor         User?        @relation("CreditActor", fields: [actorId], references: [id], onDelete: SetNull)
  usageRecordId String?      @unique
  usageRecord   UsageRecord? @relation(fields: [usageRecordId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([reason, createdAt])
}

/// One billed Faam AI Cloud request.
model UsageRecord {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId          String?
  token            ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  /// Public model id (e.g. "faam-fast").
  model            String
  promptTokens     Int
  completionTokens Int
  credits          Int
  /// True when the upstream did not report usage and tokens were estimated (chars ÷ 4).
  estimated        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  transaction CreditTransaction?

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Dialog announcements published by admins and shown by the desktop app at startup.
model Announcement {
  id          String                  @id @default(cuid())
  status      AnnouncementStatus      @default(draft)
  kind        AnnouncementKind        @default(rich)
  level       AnnouncementLevel       @default(info)
  displayMode AnnouncementDisplayMode @default(once)
  titleVi     String
  titleEn     String?
  /// Plain text with line breaks (kind = rich).
  bodyVi      String?
  bodyEn      String?
  /// Untrusted-by-design HTML (kind = html), only ever served from the sandboxed frame route.
  htmlVi      String?
  htmlEn      String?
  /// Uploaded image (served by /api/v1/announcements/{id}/image) ...
  imageId     String?
  image       AnnouncementImage?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// ... or an external https image URL (never both).
  imageUrl    String?
  /// https only.
  linkUrl     String?
  linkLabelVi String?
  linkLabelEn String?
  /// Comma-separated subset of "mac,win,linux"; empty = every platform.
  platforms   String                  @default("")
  /// Inclusive app version range ("x.y.z"); null = unbounded.
  minVersion  String?
  maxVersion  String?
  startsAt    DateTime                @default(now())
  endsAt      DateTime?
  /// Higher first.
  priority    Int                     @default(0)
  createdById String?
  createdBy   User?                   @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?                   @relation("AnnouncementUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status, startsAt])
  @@index([status, priority, startsAt])
  @@index([imageId])
  @@index([updatedAt])
}

/// Images uploaded for announcements (png/jpeg/webp/gif, at most 2 MB, verified by magic bytes).
model AnnouncementImage {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  width     Int?
  height    Int?
  /// Size in bytes.
  size      Int
  createdAt DateTime @default(now())

  announcements Announcement[]

  @@index([createdAt])
}
